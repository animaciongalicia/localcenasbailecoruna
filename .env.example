# Copia a .env.local en local. En Vercel: Settings → Environment Variables. Ninguna es obligatoria.
# Las NEXT_PUBLIC_* se incrustan al compilar: si cambias alguna en Vercel, REDESPLIEGA.

# Dominio canónico (sin barra final). Por defecto: https://www.los7pc.com
NEXT_PUBLIC_SITE_URL=https://www.los7pc.com

# Indexación: por defecto SÍ en producción de Vercel y NO en previews/local. "false" la apaga; "true" la fuerza.
NEXT_PUBLIC_INDEXAR=

# Google Analytics 4. Por defecto la propiedad actual (G-ZJ5NFSNCB1). Vacío = desactivado.
NEXT_PUBLIC_GA4_ID=G-ZJ5NFSNCB1

# Google Ads (si falta, no se carga). Etiquetas de las acciones de conversión.
NEXT_PUBLIC_GADS_ID=
NEXT_PUBLIC_GADS_LABEL_WHATSAPP=
NEXT_PUBLIC_GADS_LABEL_PHONE=
NEXT_PUBLIC_GADS_LABEL_FORM=

# Meta Pixel (si falta, no se carga)
NEXT_PUBLIC_META_PIXEL_ID=
